{
  "name": "eventgenie",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first AI celebration and event planner.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./public/tailwind.input.css -o ./public/tailwind.css --minify",
    "prestart": "npm run build:css",
    "predev": "npm run build:css",
    "check": "node --check server.js && node --check public/app.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
